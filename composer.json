{
    "name": "onahchukwuemeka/umugwuanyi-oyi",
    "description": "Umu-Oyi Family Community Web App – By Onah Chukwuemeka Henry",
    "type": "project",
    "authors": [
        {
            "name": "Onah Chukwuemeka Henry",
            "email": "chukwuemekahenry25052004@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
